# Bedrock components. Wired into the browser by a single patch that appends
# "//bedrock:bedrock" to the chrome/browser deps (see docs/design/006-search-system.md).

source_set("omnibox") {
  sources = [
    "omnibox/input_parser.cc",
    "omnibox/input_parser.h",
  ]
}

source_set("search") {
  sources = [
    "search/engine_selector.cc",
    "search/engine_selector.h",
  ]
}

# The cross-layer resolver sits above every policy component, so it lives in
# its own target: putting it in ":privacy" would make privacy depend on
# session, which depends on privacy.
source_set("policy") {
  sources = [
    "privacy/privacy_policy.cc",
    "privacy/privacy_policy.h",
  ]
  deps = [
    ":net",
    ":privacy",
    ":session",
  ]
}

source_set("extensions") {
  sources = [
    "extensions/extension_registry.cc",
    "extensions/extension_registry.h",
  ]
}

source_set("ui") {
  sources = [
    "ui/sidebar.cc",
    "ui/sidebar.h",
    "ui/tab_model.cc",
    "ui/tab_model.h",
    "ui/theme_engine.cc",
    "ui/theme_engine.h",
  ]
}

source_set("security") {
  sources = [
    "security/security_baseline.cc",
    "security/security_baseline.h",
  ]
}

source_set("session") {
  sources = [
    "session/browsing_mode.cc",
    "session/browsing_mode.h",
    "session/new_identity.cc",
    "session/new_identity.h",
    "session/profile_manager.cc",
    "session/profile_manager.h",
    "session/workspace_manager.cc",
    "session/workspace_manager.h",
  ]
  deps = [
    ":net",
    ":privacy",
  ]
}

source_set("downloads") {
  sources = [
    "downloads/download_manager.cc",
    "downloads/download_manager.h",
  ]
}

source_set("passwords") {
  sources = [
    "passwords/password_store.cc",
    "passwords/password_store.h",
  ]
}

source_set("data") {
  sources = [
    "data/bookmark_store.cc",
    "data/bookmark_store.h",
    "data/history_store.cc",
    "data/history_store.h",
  ]
}

source_set("net") {
  sources = [
    "net/dns_settings.cc",
    "net/dns_settings.h",
    "net/https_policy.cc",
    "net/https_policy.h",
    "net/storage_isolation.cc",
    "net/storage_isolation.h",
    "net/webrtc_policy.cc",
    "net/webrtc_policy.h",
  ]
  deps = [ ":privacy" ]
}

source_set("blocking") {
  sources = [
    "blocking/blocking_pipeline.cc",
    "blocking/blocking_pipeline.h",
    "blocking/filter_engine.cc",
    "blocking/filter_engine.h",
    "blocking/tracker_heuristic.cc",
    "blocking/tracker_heuristic.h",
  ]
  deps = [ ":privacy" ]
}

source_set("privacy") {
  sources = [
    "privacy/fingerprint_policy.cc",
    "privacy/fingerprint_policy.h",
    "privacy/privacy_engine.h",
    "privacy/protection_controller.cc",
    "privacy/protection_controller.h",
  ]
}

group("bedrock") {
  public_deps = [
    ":omnibox",
    ":privacy",
    ":search",
  ]
}

# Tests: the *_test.cc files next to these sources are dependency-free host
# tests with their own main(), run by scripts/run_host_tests.sh in CI. They are
# deliberately NOT in a gtest target — anything that needs Chromium types gets a
# separate *_unittest.cc added to //chrome/test:unit_tests when that day comes.
