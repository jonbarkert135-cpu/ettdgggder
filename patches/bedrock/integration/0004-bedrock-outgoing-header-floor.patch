 #include <algorithm>
 #include <limits>
 #include <map>
@@ -53,6 +56,7 @@
 #include "net/base/mime_sniffer.h"
 #include "net/base/net_error_details.h"
 #include "net/base/net_errors.h"
+#include "net/base/registry_controlled_domains/registry_controlled_domain.h"
 #include "net/base/proxy_chain.h"
 #include "net/base/schemeful_site.h"
 #include "net/base/task/task_runner.h"
@@ -142,6 +146,55 @@ namespace network {
 
 namespace {
 
+// Bedrock: outgoing-header floor (phase 7). Chromium has already applied its own
+// referrer policy and assembled its client hints; this asks the Bedrock policy
+// whether any of it is more than the site should receive, and applies only what
+// comes back. Translation and application, no policy: the decision lives in
+// src_overrides/bedrock/privacy/network/request_headers.* and is host-tested.
+void ApplyBedrockHeaderFloor(net::URLRequest* request,
+                             bool is_navigation) {
+  const std::optional<url::Origin>& top_frame_origin =
+      request->isolation_info().top_frame_origin();
+  if (!top_frame_origin.has_value() || top_frame_origin->opaque() ||
+      !request->url().SchemeIsHTTPOrHTTPS()) {
+    return;
+  }
+
+  bedrock::integration::OutgoingHeaderRequest ask;
+  ask.referrer = request->referrer();
+  ask.target_url = request->url().spec();
+  ask.target_host = request->url().host();
+  ask.target_etld1 = net::registry_controlled_domains::GetDomainAndRegistry(
+      ask.target_host,
+      net::registry_controlled_domains::INCLUDE_PRIVATE_REGISTRIES);
+  ask.top_host = top_frame_origin->host();
+  ask.top_etld1 = net::registry_controlled_domains::GetDomainAndRegistry(
+      ask.top_host, net::registry_controlled_domains::INCLUDE_PRIVATE_REGISTRIES);
+  ask.navigation = is_navigation;
+  for (const auto& header : request->extra_request_headers().GetHeaderVector()) {
+    ask.present_headers.push_back(header.key);
+  }
+
+  const bedrock::integration::OutgoingHeaderDecision decision =
+      bedrock::integration::DecideHeaders(ask);
+  if (decision.referrer_changed) {
+    // SetReferrer before Start() is the supported way to shorten a referrer;
+    // the policy stays as Chromium computed it, only the value gets smaller.
+    request->SetReferrer(decision.referrer);
+    LOG(WARNING) << bedrock::integration::kLogPrefix << "referrer "
+                 << decision.referrer_scope << " for " << ask.target_host
+                 << " on " << ask.top_host;
+  }
+  for (const std::string& name : decision.remove_headers) {
+    request->RemoveRequestHeaderByName(name);
+    LOG(WARNING) << bedrock::integration::kLogPrefix << "dropped hint " << name
+                 << " for " << ask.target_host;
+  }
+}
+}  // namespace
