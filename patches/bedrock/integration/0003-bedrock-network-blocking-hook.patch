 namespace {
 
+// Bedrock: translation only. The registrable domain comes from Chromium's
+// public-suffix list because a blocker that guesses at registrable domains
+// treats co.uk as a site, and the request kind is mapped explicitly so that a
+// new upstream RequestDestination is a compile error here instead of silently
+// becoming "other".
+std::string BedrockRegistrableDomain(const std::string& host) {
+  return net::registry_controlled_domains::GetDomainAndRegistry(
+      host, net::registry_controlled_domains::INCLUDE_PRIVATE_REGISTRIES);
+}
+
+bedrock::integration::RequestKind BedrockRequestKind(
+    network::mojom::RequestDestination destination) {
+  using Kind = bedrock::integration::RequestKind;
+  switch (destination) {
+    case network::mojom::RequestDestination::kDocument:
+      return Kind::kDocument;
+    case network::mojom::RequestDestination::kFrame:
+    case network::mojom::RequestDestination::kIframe:
+    case network::mojom::RequestDestination::kFencedframe:
+      return Kind::kSubdocument;
+    case network::mojom::RequestDestination::kScript:
+    case network::mojom::RequestDestination::kServiceWorker:
+    case network::mojom::RequestDestination::kSharedWorker:
+    case network::mojom::RequestDestination::kWorker:
+    case network::mojom::RequestDestination::kAudioWorklet:
+    case network::mojom::RequestDestination::kPaintWorklet:
+    case network::mojom::RequestDestination::kSharedStorageWorklet:
+      return Kind::kScript;
+    case network::mojom::RequestDestination::kStyle:
+    case network::mojom::RequestDestination::kXslt:
+      return Kind::kStylesheet;
+    case network::mojom::RequestDestination::kImage:
+      return Kind::kImage;
+    case network::mojom::RequestDestination::kFont:
+      return Kind::kFont;
+    case network::mojom::RequestDestination::kAudio:
+    case network::mojom::RequestDestination::kVideo:
+    case network::mojom::RequestDestination::kTrack:
+      return Kind::kMedia;
+    case network::mojom::RequestDestination::kEmpty:
+    case network::mojom::RequestDestination::kJson:
+      return Kind::kXhr;
+    case network::mojom::RequestDestination::kReport:
+    case network::mojom::RequestDestination::kSpeculationRules:
+      return Kind::kPing;
+    default:
+      return Kind::kOther;
+  }
+}
+
+// Asks the Bedrock pipeline about one request. Returns true when the request
+// must not be made; the caller performs the failure, this function performs
+// nothing.
+bool BedrockBlocksRequest(const network::ResourceRequest& resource_request,
+                          const net::IsolationInfo& factory_isolation_info) {
+  static const bool logged_once = [] {
+    LOG(WARNING) << bedrock::integration::kLogPrefix
+                 << bedrock::integration::NetworkHookStartupLine();
+    return true;
+  }();
+  (void)logged_once;
+
+  if (!resource_request.url.SchemeIsHTTPOrHTTPS()) {
+    return false;
+  }
+
+  const std::optional<url::Origin>* top_frame_origin = nullptr;
+  if (resource_request.trusted_params) {
+    top_frame_origin = &resource_request.trusted_params->isolation_info
+                            .top_frame_origin();
+  }
+  if (top_frame_origin == nullptr || !top_frame_origin->has_value()) {
+    top_frame_origin = &factory_isolation_info.top_frame_origin();
+  }
+
+  bedrock::integration::NetworkRequest request;
+  request.url = resource_request.url.spec();
+  request.host = resource_request.url.host();
+  request.etld1 = BedrockRegistrableDomain(request.host);
+  if (top_frame_origin->has_value() && !(*top_frame_origin)->opaque()) {
+    request.top_host = (*top_frame_origin)->host();
+    request.top_etld1 = BedrockRegistrableDomain(request.top_host);
+  }
+  request.kind = BedrockRequestKind(resource_request.destination);
+
+  const bedrock::integration::NetworkDecision decision =
+      bedrock::integration::DecideRequest(request);
+  if (!decision.blocked) {
+    return false;
+  }
+  LOG(WARNING) << bedrock::integration::kLogPrefix << "blocked "
+               << request.host << " on " << request.top_host << " ("
+               << decision.reason << ": " << decision.detail << ")";
+  return true;
+}
